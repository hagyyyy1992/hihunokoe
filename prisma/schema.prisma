generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String             @id @default(uuid()) @db.Uuid
  userName                String             @unique @map("user_name") @db.VarChar(100)
  email                   String             @unique @db.VarChar(255)
  passwordHash            String             @map("password_hash") @db.VarChar(255)
  isActive                Boolean            @default(true) @map("is_active")
  deletedAt               DateTime?          @map("deleted_at") @db.Timestamptz(6)
  role                    UserRole?          @map("role")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  emailVerificationExpiry DateTime?          @map("email_verification_expiry") @db.Timestamptz(6)
  emailVerificationToken  String?            @map("email_verification_token") @db.VarChar(255)
  emailVerified           Boolean            @default(false) @map("email_verified")
  passwordResetToken      String?            @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiry     DateTime?          @map("password_reset_expiry") @db.Timestamptz(6)
  failedLoginAttempts     Int                @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?          @map("locked_until") @db.Timestamptz(6)
  birthDate               DateTime?          @map("birth_date") @db.Date
  gender                  Gender?            @map("gender")
  allergies               AllergyType[]      @map("allergies")
  allergiesOther          String?            @map("allergies_other")
  skinTypeOther           String?            @map("skin_type_other") @db.VarChar(100)
  skinType                SkinType?          @map("skin_type")
  privacyAcceptedAt       DateTime?          @map("privacy_accepted_at") @db.Timestamptz(6)
  termsAcceptedAt         DateTime?          @map("terms_accepted_at") @db.Timestamptz(6)
  comments                Comment[]
  respondedInquiries      ContactInquiry[]   @relation("UserRespondedInquiries")
  contactInquiries        ContactInquiry[]   @relation("UserContactInquiries")
  empathies               Empathy[]
  postPermissions         PostPermission[]
  posts                   Post[]
  withdrawalSurveys       WithdrawalSurvey[]

  @@index([createdAt(sort: Desc)])
  @@index([isActive, deletedAt], map: "users_active_deleted_idx")
  @@index([isActive, createdAt(sort: Desc)], map: "users_active_created_idx")
  @@map("users")
}

model AdminUser {
  id                  String      @id @default(uuid()) @db.Uuid
  adminName           String      @unique @map("admin_name") @db.VarChar(100)
  email               String      @unique @db.VarChar(255)
  passwordHash        String      @map("password_hash") @db.VarChar(255)
  role                AdminRole   @default(ADMIN) @map("role")
  isActive            Boolean     @default(true) @map("is_active")
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(6)
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(6)
  permissions         Json?       @map("permissions")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?     @map("created_by") @db.Uuid
  adminLogs           AdminLog[]
  createdByAdmin      AdminUser?  @relation("AdminUserCreatedBy", fields: [createdBy], references: [id])
  createdAdmins       AdminUser[] @relation("AdminUserCreatedBy")

  @@map("admin_users")
}

model Post {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  title             String           @db.VarChar(200)
  content           String
  cosmeticName      String           @map("cosmetic_name") @db.VarChar(200)
  cosmeticCategory  String?          @map("cosmetic_category") @db.VarChar(100)
  skinType          String?          @map("skin_type") @db.VarChar(50)
  usageSituation    Json?            @map("usage_situation")
  experienceDetails Json?            @map("experience_details")
  moodTag           String?          @map("mood_tag") @db.VarChar(50)
  status            String           @default("published") @db.VarChar(20)
  viewCount         Int              @default(0) @map("view_count")
  empathyCount      Int              @default(0) @map("empathy_count")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz(6)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)
  comments          Comment[]
  empathies         Empathy[]
  postPermissions   PostPermission[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([userId, status])
  @@index([cosmeticCategory, status])
  @@index([skinType, status])
  @@index([moodTag, status])
  @@index([status, cosmeticCategory, createdAt(sort: Desc)])
  @@index([status, skinType, createdAt(sort: Desc)])
  @@index([status, moodTag, createdAt(sort: Desc)])
  @@index([status, cosmeticCategory, skinType, moodTag, createdAt(sort: Desc)], map: "posts_multi_filter_idx")
  @@index([viewCount(sort: Desc)])
  @@index([deletedAt, status, createdAt(sort: Desc)], map: "posts_deleted_status_created_idx")
  @@map("posts")
}

model PostPermission {
  id             String   @id @default(uuid()) @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  permissionType String   @map("permission_type") @db.VarChar(20)
  grantedAt      DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, permissionType])
  @@map("post_permissions")
}

model Empathy {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  empathyType String   @map("empathy_type") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([postId, createdAt(sort: Desc)])
  @@map("empathies")
}

model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  postId          String    @map("post_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  content         String
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([postId, createdAt(sort: Desc)])
  @@map("comments")
}

model AdminLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  action      String    @map("action") @db.VarChar(255)
  target      String?   @map("target") @db.VarChar(255)
  details     Json?     @map("details")
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  targetType  String?   @map("target_type") @db.VarChar(50)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

model WithdrawalSurvey {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  reason         WithdrawalReason @map("reason")
  reasonOther    String?          @map("reason_other")
  feedback       String?          @map("feedback")
  wouldRecommend Boolean?         @map("would_recommend")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_surveys")
}

model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType @unique @map("type")
  title       String            @map("title") @db.VarChar(255)
  content     String            @map("content")
  version     String            @map("version") @db.VarChar(50)
  publishedAt DateTime          @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("legal_documents")
}

model ContactInquiry {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @map("name") @db.VarChar(100)
  email           String          @map("email") @db.VarChar(255)
  subject         String          @map("subject") @db.VarChar(200)
  message         String          @map("message")
  category        ContactCategory @map("category")
  status          ContactStatus   @default(UNREAD) @map("status")
  ipAddress       String?         @map("ip_address") @db.VarChar(45)
  userAgent       String?         @map("user_agent")
  adminNotes      String?         @map("admin_notes")
  respondedAt     DateTime?       @map("responded_at") @db.Timestamptz(6)
  respondedBy     String?         @map("responded_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  userId          String?         @map("user_id") @db.Uuid
  respondedByUser User?           @relation("UserRespondedInquiries", fields: [respondedBy], references: [id])
  user            User?           @relation("UserContactInquiries", fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

enum SkinType {
  normal      @map("normal")
  dry         @map("dry")
  oily        @map("oily")
  combination @map("combination")
  sensitive   @map("sensitive")
  other       @map("other")

  @@map("skin_types")
}

enum Gender {
  male   @map("male")
  female @map("female")
  other  @map("other")

  @@map("genders")
}

enum AllergyType {
  fragrance    @map("fragrance")
  alcohol      @map("alcohol")
  paraben      @map("paraben")
  sulfate      @map("sulfate")
  silicone     @map("silicone")
  mineral_oil  @map("mineral_oil")
  formaldehyde @map("formaldehyde")
  latex        @map("latex")
  nickel       @map("nickel")
  other        @map("other")

  @@map("allergy_types")
}

enum UserRole {
  USER        @map("user")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super_admin")

  @@map("user_roles")
}

enum AdminRole {
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super_admin")

  @@map("admin_roles")
}

enum WithdrawalReason {
  not_useful        @map("not_useful")
  privacy_concerns  @map("privacy_concerns")
  too_many_emails   @map("too_many_emails")
  found_alternative @map("found_alternative")
  temporary_break   @map("temporary_break")
  technical_issues  @map("technical_issues")
  other             @map("other")

  @@map("withdrawal_reasons")
}

enum LegalDocumentType {
  terms_of_service @map("terms_of_service")
  privacy_policy   @map("privacy_policy")

  @@map("legal_document_types")
}

enum ContactCategory {
  general         @map("general")
  bug_report      @map("bug_report")
  feature_request @map("feature_request")
  account         @map("account")
  privacy         @map("privacy")
  other           @map("other")

  @@map("contact_categories")
}

enum ContactStatus {
  UNREAD      @map("unread")
  READ        @map("read")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
  SPAM        @map("spam")

  @@map("contact_statuses")
}
