generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String           @id @default(uuid()) @db.Uuid
  userName                String           @unique @map("user_name") @db.VarChar(100)
  email                   String           @unique @db.VarChar(255)
  passwordHash            String           @map("password_hash") @db.VarChar(255)
  isActive                Boolean          @default(true) @map("is_active")
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(6)
  role                    UserRole         @default(USER) @map("role")
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  emailVerificationExpiry DateTime?        @map("email_verification_expiry") @db.Timestamptz(6)
  emailVerificationToken  String?          @map("email_verification_token")
  emailVerified           Boolean          @default(false) @map("email_verified")
  resetPasswordToken      String?          @map("reset_password_token")
  resetPasswordExpires    DateTime?        @map("reset_password_expires") @db.Timestamptz(6)
  lastLogin               DateTime?        @map("last_login") @db.Timestamptz(6)
  profileImageUrl         String?          @map("profile_image_url")
  skinType                SkinType?        @map("skin_type")
  age                     Int?             @map("age")
  birthDate               DateTime?        @map("birth_date") @db.Date
  gender                  Gender?          @map("gender")
  allergies               AllergyType[]    @map("allergies")
  allergiesOther          String?          @map("allergies_other")
  bodyType                BodyType?        @map("body_type")
  skinTypeOther           String?          @map("skin_type_other")
  bodyTypeOther           String?          @map("body_type_other")
  selfIntroduction        String?          @map("self_introduction") @db.Text
  comments                Comment[]
  empathies               Empathy[]
  postPermissions         PostPermission[]
  posts                   Post[]
  adminLogs               AdminLog[]
  reportsBy               Report[]         @relation("ReportedBy")
  reportsAgainst          Report[]         @relation("ReportsAgainst")
  reportsResolved         Report[]         @relation("ReportsResolved")

  @@map("users")
}

model Post {
  id              String           @id @default(uuid()) @db.Uuid
  title           String           @db.VarChar(200)
  productName     String           @map("product_name") @db.VarChar(200)
  productBrand    String?          @map("product_brand") @db.VarChar(100)
  productCategory String           @map("product_category") @db.VarChar(100)
  skinType        SkinType         @map("skin_type")
  productRating   Int              @map("product_rating")
  content         String           @db.Text
  mood            String           @db.VarChar(50)
  isPublished     Boolean          @default(false) @map("is_published")
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(6)
  empathyCount    Int              @default(0) @map("empathy_count")
  userId          String           @map("user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  comments        Comment[]
  empathies       Empathy[]
  postPermissions PostPermission[]
  reports         Report[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model PostPermission {
  id             String   @id @default(uuid()) @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  permissionType String   @map("permission_type") @db.VarChar(50)
  canEdit        Boolean  @default(false) @map("can_edit")
  canDelete      Boolean  @default(false) @map("can_delete")
  canComment     Boolean  @default(true) @map("can_comment")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, permissionType])
  @@map("post_permissions")
}

model Empathy {
  id          String      @id @default(uuid()) @db.Uuid
  postId      String      @map("post_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  empathyType EmpathyType @default(LIKE) @map("empathy_type")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("empathies")
}

model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  content         String    @db.Text
  userId          String    @map("user_id") @db.Uuid
  postId          String    @map("post_id") @db.Uuid
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  isPublished     Boolean   @default(true) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  reports         Report[]
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model AdminLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @map("action") @db.VarChar(100)
  targetId  String?  @map("target_id") @db.Uuid
  details   Json?    @map("details")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  reporterId  String       @map("reporter_id") @db.Uuid
  reportedId  String?      @map("reported_id") @db.Uuid
  postId      String?      @map("post_id") @db.Uuid
  commentId   String?      @map("comment_id") @db.Uuid
  reason      ReportReason @map("reason")
  description String?      @map("description")
  status      ReportStatus @default(PENDING) @map("status")
  resolvedBy  String?      @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz(6)
  resolution  String?      @map("resolution")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter User     @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User?    @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
  post     Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  resolver User?    @relation("ReportsResolved", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@map("reports")
}

enum SkinType {
  OILY      @map("oily")
  DRY       @map("dry")
  MIXED     @map("mixed")
  SENSITIVE @map("sensitive")
  NORMAL    @map("normal")
  OTHER     @map("other")

  @@map("skin_types")
}

enum Gender {
  MALE      @map("male")
  FEMALE    @map("female")
  OTHER     @map("other")
  NO_ANSWER @map("no_answer")

  @@map("genders")
}

enum AllergyType {
  POLLEN      @map("pollen")
  DUST        @map("dust")
  FOOD        @map("food")
  METAL       @map("metal")
  COSMETICS   @map("cosmetics")
  CHEMICALS   @map("chemicals")
  ANIMALS     @map("animals")
  MEDICATIONS @map("medications")

  @@map("allergy_types")
}

enum BodyType {
  SLIM    @map("slim")
  AVERAGE @map("average")
  PLUMP   @map("plump")
  OTHER   @map("other")

  @@map("body_types")
}

enum UserRole {
  USER        @map("user")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super_admin")

  @@map("user_roles")
}

enum ReportReason {
  SPAM          @map("spam")
  HARASSMENT    @map("harassment")
  INAPPROPRIATE @map("inappropriate")
  COPYRIGHT     @map("copyright")
  FAKE_INFO     @map("fake_info")
  VIOLENCE      @map("violence")
  HATE_SPEECH   @map("hate_speech")
  OTHER         @map("other")

  @@map("report_reasons")
}

enum ReportStatus {
  PENDING   @map("pending")
  REVIEWING @map("reviewing")
  RESOLVED  @map("resolved")
  DISMISSED @map("dismissed")

  @@map("report_statuses")
}

enum EmpathyType {
  LIKE    @map("like")
  LOVE    @map("love")
  HELPFUL @map("helpful")
  AMAZING @map("amazing")

  @@map("empathy_types")
}
