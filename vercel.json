{
  "functions": {
    "src/app/api/test/**/*.ts": false,
    "src/app/api/v2/**/*.ts": false,
    "src/app/api/posts/test/**/*.ts": false,
    "src/app/api/comments/**/*.ts": false,
    "src/app/api/posts/comments/**/*.ts": false,
    "src/app/api/posts/empathy/**/*.ts": false,
    "src/app/api/posts/get/**/*.ts": false,
    "src/app/api/posts/delete/**/*.ts": false,
    "src/app/api/posts/update/**/*.ts": false,
    "src/app/api/admin/**/*.ts": false,
    "src/app/api/auth/resend-verification/**/*.ts": false,
    "src/app/api/auth/verify-email/**/*.ts": false,
    "src/app/api/auth/verify-reset-token/**/*.ts": false
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
