{
  "name": "usaka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:local": "prisma generate && next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest __tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:threshold": "node scripts/ci-e2e-runner.js",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:setup": "docker-compose up -d postgres",
    "db:stop": "docker-compose stop",
    "mailhog:start": "docker-compose up -d mailhog",
    "mailhog:stop": "docker-compose stop mailhog",
    "dev:full": "supabase start && npm run mailhog:start && npm run db:seed && npm run dev",
    "dev:setup": "supabase start && npx prisma migrate dev && npm run db:seed && npm run mailhog:start",
    "db:reset": "docker-compose down -v && docker volume prune -f && docker-compose up -d postgres && sleep 3 && npm run db:migrate",
    "db:migrate": "DATABASE_URL=\"postgresql://postgres:password@localhost:5432/usaka_dev\" prisma migrate dev && npm run db:seed",
    "db:studio": "DATABASE_URL=\"postgresql://postgres:password@localhost:5432/usaka_dev\" prisma studio",
    "db:push": "DATABASE_URL=\"postgresql://postgres:password@localhost:5432/usaka_dev\" prisma db push",
    "db:status": "node scripts/check-db-status.js",
    "db:seed": "node scripts/seed.js",
    "db:nuke": "docker-compose down && docker volume rm usaka_postgres_data || true && docker-compose up -d postgres && sleep 5 && npm run db:migrate",
    "db:clean": "DATABASE_URL=\"postgresql://postgres:password@localhost:5432/usaka_dev\" prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.523.0",
    "next": "15.3.4",
    "nodemailer": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@edge-runtime/jest-environment": "^4.0.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "node-fetch": "^2.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "supertest": "^7.1.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  }
}
