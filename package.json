{
  "name": "hihunokoe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run codegen && next dev --turbopack",
    "build": "prisma generate && prisma migrate deploy && npm run codegen && next build",
    "build:ci": "prisma generate && npm run codegen && next build",
    "build:check": "prisma generate && npm run codegen && next build --no-lint",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest __tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:coverage": "node scripts/e2e-coverage-report.js",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality-check": "node scripts/quality-check.js",
    "postinstall": "prisma generate",
    "db:setup": "docker compose up -d postgres",
    "db:stop": "docker compose stop",
    "mailhog:start": "docker compose up -d mailhog",
    "mailhog:stop": "docker compose stop mailhog",
    "dev:setup": "npm run db:setup && npx prisma migrate dev && npm run db:seed && npm run mailhog:start && npm run codegen",
    "db:reset": "docker compose down -v && docker volume prune -f && docker compose up -d postgres && sleep 3 && npm run db:migrate",
    "db:migrate": "prisma migrate dev && npm run db:seed",
    "db:studio": "prisma studio",
    "db:status": "node scripts/check-db-status.js",
    "db:seed": "node scripts/seed.js",
    "db:nuke": "docker compose down && docker volume rm hihunokoe_postgres_data || true && docker compose up -d postgres && sleep 5 && npm run db:migrate",
    "db:clean": "prisma migrate reset --force",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@apollo/experimental-nextjs-app-support": "^0.12.2",
    "@apollo/server": "^4.12.2",
    "@apollo/server-plugin-landing-page-graphql-playground": "^4.0.1",
    "@as-integrations/next": "^3.2.0",
    "@prisma/client": "^6.11.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "glob": "^10.4.5",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.523.0",
    "next": "15.3.4",
    "nodemailer": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.6.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@edge-runtime/jest-environment": "^4.0.0",
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@graphql-tools/graphql-file-loader": "^8.0.20",
    "@graphql-tools/load": "^8.1.0",
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.19.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "graphql-tag": "^2.12.6",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "node-fetch": "^2.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.11.0",
    "supertest": "^7.1.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "5.8.3",
    "whatwg-fetch": "^3.6.20"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  }
}
